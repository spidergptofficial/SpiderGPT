NODE_ENV=development
PORT=4000
WEB_ORIGIN=http://localhost:5173

# Supabase
# Use the Supabase Postgres connection string from Dashboard > Connect.
# Prefer the Session Pooler connection string for local development when direct IPv6 is unavailable.
DATABASE_URL=postgresql://postgres.your-project-ref:YOUR_DATABASE_PASSWORD@aws-0-your-region.pooler.supabase.com:5432/postgres
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
# Optional on the backend only. Never expose this to the frontend.
SUPABASE_SERVICE_ROLE_KEY=

# Application session signing secret
JWT_SECRET=replace-with-a-long-random-secret-at-least-48-characters

# AI
AI_PROVIDER=gemini
AI_API_KEY=your-ai-key
AI_MODEL=gemini-2.5-flash
AI_BASE_URL=

# Optional distributed rate limiting. Not required for local development.
REDIS_URL=

# Payments
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_PLAN_PRO_MONTHLY=
RAZORPAY_PLAN_PRO_YEARLY=
RAZORPAY_PLAN_PLUS_MONTHLY=
RAZORPAY_PLAN_PLUS_YEARLY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PRO_MONTHLY=
STRIPE_PRICE_PRO_YEARLY=
STRIPE_PRICE_PLUS_MONTHLY=
STRIPE_PRICE_PLUS_YEARLY=
